{
  "name": "account-switcher-for-claude-code",
  "displayName": "Account Switcher for Claude Code",
  "description": "Use multiple Claude Code accounts at the same time in VS Code / code-server — every account stays logged in permanently, each folder/chat can run its own account, and switching never interrupts running sessions. Unofficial.",
  "version": "1.0.0",
  "publisher": "faisalsannan",
  "license": "MIT",
  "author": "Faisal Sannan",
  "icon": "images/icon.png",
  "galleryBanner": { "color": "#2b2a33", "theme": "dark" },
  "homepage": "https://github.com/FaisalSannan/account-switcher-for-claude-code#readme",
  "sponsor": {
    "url": "https://github.com/sponsors/FaisalSannan"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FaisalSannan/account-switcher-for-claude-code.git"
  },
  "bugs": {
    "url": "https://github.com/FaisalSannan/account-switcher-for-claude-code/issues"
  },
  "engines": { "vscode": "^1.92.0" },
  "categories": ["Other"],
  "keywords": [
    "claude",
    "claude code",
    "vscode",
    "account switcher",
    "profile switcher",
    "multi-account",
    "switch accounts",
    "anthropic",
    "code-server"
  ],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "claudeProfileSwitcher.useProfileHere", "title": "Claude Accounts: Use Account for This Folder" },
      { "command": "claudeProfileSwitcher.addAccount", "title": "Claude Accounts: Add Account" },
      { "command": "claudeProfileSwitcher.loginProfile", "title": "Claude Accounts: Open Login Terminal for Account" },
      { "command": "claudeProfileSwitcher.showStatus", "title": "Claude Accounts: Show Status" },
      { "command": "claudeProfileSwitcher.openProfilesFolder", "title": "Claude Accounts: Open Profiles Folder" },
      { "command": "claudeProfileSwitcher.deleteProfile", "title": "Claude Accounts: Delete Account Profile" },
      { "command": "claudeProfileSwitcher.backupLogins", "title": "Claude Accounts: Backup All Logins" },
      { "command": "claudeProfileSwitcher.restoreLegacyBackup", "title": "Claude Accounts: Restore Legacy (v0.x) Backup" },
      { "command": "claudeProfileSwitcher.disableRouting", "title": "Claude Accounts: Disable Folder Routing" }
    ],
    "configuration": {
      "title": "Account Switcher for Claude Code",
      "properties": {
        "claudeProfileSwitcher.profilesRoot": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Folder holding the per-account profile directories. Empty means ~/.claude-profiles. User/machine setting only — cannot be set by a workspace, since its value is embedded in generated shell scripts."
        },
        "claudeProfileSwitcher.activeClaudeDir": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Default account's Claude config dir. Empty means ~/.claude. User/machine setting only — not overridable per workspace."
        },
        "claudeProfileSwitcher.activeClaudeJson": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Default account's Claude root JSON. Empty means ~/.claude.json. User/machine setting only — not overridable per workspace."
        },
        "claudeProfileSwitcher.maxBackups": {
          "type": "number",
          "default": 25,
          "minimum": 0,
          "description": "Maximum number of snapshots kept in <profilesRoot>/_backups (oldest pruned first). 0 disables pruning."
        }
      }
    },
    "menus": {
      "commandPalette": [
        { "command": "claudeProfileSwitcher.useProfileHere" },
        { "command": "claudeProfileSwitcher.addAccount" },
        { "command": "claudeProfileSwitcher.loginProfile" },
        { "command": "claudeProfileSwitcher.showStatus" },
        { "command": "claudeProfileSwitcher.openProfilesFolder" },
        { "command": "claudeProfileSwitcher.deleteProfile" },
        { "command": "claudeProfileSwitcher.backupLogins" },
        { "command": "claudeProfileSwitcher.restoreLegacyBackup" },
        { "command": "claudeProfileSwitcher.disableRouting" }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test": "npm run compile && node test/core.test.js",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.92.0",
    "typescript": "^5.5.4",
    "@vscode/vsce": "^3.2.1"
  }
}
